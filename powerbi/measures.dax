// Create each expression below as a separate measure. This is not a DAX query script.
// Counts are source-provider x province x period entries, NOT a count of resource datasets.

Supported Provinces = DISTINCTCOUNT(dim_area[area_code])

Verified Coverage Entries =
CALCULATE(
    COUNTROWS(fact_data_coverage),
    REMOVEFILTERS(fact_data_coverage[status]),
    fact_data_coverage[status] IN {"AVAILABLE", "NOT_PUBLISHED", "PIPELINE_ERROR"}
)

Available Coverage Entries =
COALESCE(
    CALCULATE(
        COUNTROWS(fact_data_coverage),
        REMOVEFILTERS(fact_data_coverage[status]),
        fact_data_coverage[status] = "AVAILABLE"
    ),
    0
)

Verified Coverage Rate = DIVIDE([Available Coverage Entries], [Verified Coverage Entries])

Coverage Label =
IF(
    ISBLANK([Verified Coverage Entries]) || [Verified Coverage Entries] = 0,
    "ยังไม่ตรวจสอบความครอบคลุม",
    FORMAT([Verified Coverage Rate], "0.0%")
)

Unverified Entries =
COALESCE(
    CALCULATE(
        COUNTROWS(fact_data_coverage),
        REMOVEFILTERS(fact_data_coverage[status]),
        fact_data_coverage[status] = "UNVERIFIED"
    ),
    0
)

Provinces With Verified Source Data =
CALCULATE(
    DISTINCTCOUNT(fact_data_coverage[area_code]),
    REMOVEFILTERS(fact_data_coverage[status]),
    fact_data_coverage[status] = "AVAILABLE"
)

Latest Observation UTC = MAX(fact_observation[observed_at])

Latest Publication UTC = MAX(fact_observation[release_at])

Observation Rows = COUNTROWS(fact_observation)

Observation Value (single row) =
IF(COUNTROWS(fact_observation) = 1, MAX(fact_observation[value]), BLANK())

Observation Kind (single row) =
IF(COUNTROWS(fact_observation) = 1, SELECTEDVALUE(fact_observation[data_kind]), BLANK())

Observation Unit (single row) =
IF(COUNTROWS(fact_observation) = 1, SELECTEDVALUE(fact_observation[unit]), BLANK())

Coverage Status Color =
SWITCH(
    SELECTEDVALUE(fact_data_coverage[status]),
    "AVAILABLE", "#24634A",
    "NOT_PUBLISHED", "#8C6517",
    "PIPELINE_ERROR", "#A12F35",
    "NOT_APPLICABLE", "#7D857C",
    "#677269"
)

// Descriptive prices can show release_unknown; forecast/backtests still require release_at.
National Farmgate Price Native Unit =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "oae",
        fact_observation[spatial_support] = "national",
        fact_observation[measure] = "price",
        KEEPFILTERS(fact_observation[price_type] = "farm_gate"),
        fact_observation[data_kind] = "official",
        fact_observation[quality_flag] IN {"good", "valid", "release_unknown"}
    )
RETURN
IF(
    NOT ISCROSSFILTERED(dim_area[area_code]) &&
    NOT ISCROSSFILTERED(dim_admin_area[area_code]) &&
    HASONEVALUE(dim_period[period]) && COUNTROWS(SeriesRows) = 1,
    MAXX(SeriesRows, fact_observation[value]),
    BLANK()
)

National Farmgate Price Unit =
IF(
    NOT ISBLANK([National Farmgate Price Native Unit]),
    CALCULATE(
        SELECTEDVALUE(fact_observation[unit]),
        fact_observation[source_id] = "oae",
        fact_observation[spatial_support] = "national",
        fact_observation[measure] = "price",
        KEEPFILTERS(fact_observation[price_type] = "farm_gate"),
        fact_observation[data_kind] = "official",
        fact_observation[quality_flag] IN {"good", "valid", "release_unknown"}
    ),
    BLANK()
)

National Farmgate Price THB per kg =
CALCULATE([National Farmgate Price Native Unit], KEEPFILTERS(fact_observation[unit] = "THB/kg"))

National Price Previous Month THB per kg =
VAR PreviousMonth = EDATE(MAX(dim_period[month_start]), -1)
RETURN
IF(
    HASONEVALUE(dim_period[period]) && NOT ISBLANK([National Farmgate Price THB per kg]),
    CALCULATE(
        [National Farmgate Price THB per kg],
        REMOVEFILTERS(dim_period),
        TREATAS({PreviousMonth}, dim_period[month_start])
    ),
    BLANK()
)

National Price Month Change Pct =
VAR CurrentPrice = [National Farmgate Price THB per kg]
VAR PreviousPrice = [National Price Previous Month THB per kg]
RETURN
IF(
    NOT ISBLANK(CurrentPrice) && NOT ISBLANK(PreviousPrice),
    DIVIDE(CurrentPrice - PreviousPrice, PreviousPrice),
    BLANK()
)

Grid Point Rainfall mm =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "open_meteo",
        fact_observation[spatial_support] = "grid_point",
        fact_observation[measure] = "rainfall",
        fact_observation[unit] = "mm",
        fact_observation[data_kind] = "estimated",
        fact_observation[quality_flag] IN {"good", "valid"}
    )
VAR Locations = DISTINCT(SELECTCOLUMNS(SeriesRows, "Location", fact_observation[location_id]))
VAR Days = DISTINCT(SELECTCOLUMNS(SeriesRows, "Day", fact_observation[observed_at]))
RETURN
IF(
    COUNTROWS(Locations) = 1 && COUNTROWS(Days) = COUNTROWS(SeriesRows),
    SUMX(SeriesRows, fact_observation[value]),
    BLANK()
)

Rainfall Valid Days =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "open_meteo",
        fact_observation[spatial_support] = "grid_point",
        fact_observation[measure] = "rainfall",
        fact_observation[unit] = "mm",
        fact_observation[data_kind] = "estimated",
        fact_observation[quality_flag] IN {"good", "valid"}
    )
RETURN
IF(NOT ISBLANK([Grid Point Rainfall mm]), COUNTROWS(FILTER(SeriesRows, NOT ISBLANK(fact_observation[value]))), BLANK())

Grid Point Mean Daily Tmax C =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "open_meteo",
        fact_observation[spatial_support] = "grid_point",
        fact_observation[measure] = "temperature_max",
        fact_observation[unit] = "°C",
        fact_observation[data_kind] = "estimated",
        fact_observation[quality_flag] IN {"good", "valid"}
    )
VAR Locations = DISTINCT(SELECTCOLUMNS(SeriesRows, "Location", fact_observation[location_id]))
VAR Days = DISTINCT(SELECTCOLUMNS(SeriesRows, "Day", fact_observation[observed_at]))
RETURN
IF(COUNTROWS(Locations) = 1 && COUNTROWS(Days) = COUNTROWS(SeriesRows), AVERAGEX(SeriesRows, fact_observation[value]), BLANK())

Medium Reservoir Count =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "rid",
        fact_observation[spatial_support] = "reservoir",
        fact_observation[measure] = "reservoir_volume",
        NOT ISBLANK(fact_observation[value])
    )
RETURN
COUNTROWS(DISTINCT(SELECTCOLUMNS(SeriesRows, "Location", fact_observation[location_id])))

Medium Reservoir Total Volume MCM =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "rid",
        fact_observation[spatial_support] = "reservoir",
        fact_observation[measure] = "reservoir_volume",
        fact_observation[unit] = "MCM",
        fact_observation[data_kind] = "official"
    )
RETURN
IF(
    COUNTROWS(SeriesRows) > 0,
    SUMX(SeriesRows, fact_observation[value]),
    BLANK()
)

Medium Reservoir Total Capacity MCM =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "rid",
        fact_observation[spatial_support] = "reservoir",
        fact_observation[measure] = "reservoir_storage_capacity",
        fact_observation[unit] = "MCM",
        fact_observation[data_kind] = "official"
    )
RETURN
IF(
    COUNTROWS(SeriesRows) > 0,
    SUMX(SeriesRows, fact_observation[value]),
    BLANK()
)

Medium Reservoir Total Dead Storage MCM =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "rid",
        fact_observation[spatial_support] = "reservoir",
        fact_observation[measure] = "reservoir_dead_storage",
        fact_observation[unit] = "MCM",
        fact_observation[data_kind] = "official"
    )
RETURN
IF(
    COUNTROWS(SeriesRows) > 0,
    SUMX(SeriesRows, fact_observation[value]),
    BLANK()
)

Medium Reservoir Storage Pct =
VAR TotalVol = [Medium Reservoir Total Volume MCM]
VAR TotalCap = [Medium Reservoir Total Capacity MCM]
RETURN
IF(
    NOT ISBLANK(TotalVol) && NOT ISBLANK(TotalCap) && TotalCap > 0,
    DIVIDE(TotalVol, TotalCap),
    BLANK()
)

Production Source Rows = COUNTROWS(fact_production_source)

Production Matched Rows =
CALCULATE(COUNTROWS(fact_production_source), fact_production_source[mapping_status] = "matched_snapshot")

Reported Production kg Single Row =
IF(COUNTROWS(fact_production_source) = 1, MAX(fact_production_source[production_kg]), BLANK())

Reviewed Production kg = BLANK()

Satellite Observation Count =
CALCULATE(
    COUNTROWS(fact_observation),
    fact_observation[source_id] = "modis",
    fact_observation[spatial_support] = "grid_point"
)

Latest NDVI =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "modis",
        fact_observation[spatial_support] = "grid_point",
        fact_observation[measure] = "ndvi",
        fact_observation[unit] = "index",
        NOT ISBLANK(fact_observation[value])
    )
RETURN
IF(
    COUNTROWS(SeriesRows) = 1,
    MAX(fact_observation[value]),
    IF(
        COUNTROWS(SeriesRows) > 1,
        AVERAGEX(SeriesRows, fact_observation[value]),
        BLANK()
    )
)

NDVI Valid Pixel Fraction =
VAR SeriesRows =
    CALCULATETABLE(
        fact_observation,
        fact_observation[source_id] = "modis",
        fact_observation[spatial_support] = "grid_point",
        fact_observation[measure] = "ndvi_valid_pixel_fraction",
        fact_observation[unit] = "fraction",
        NOT ISBLANK(fact_observation[value])
    )
RETURN
IF(
    COUNTROWS(SeriesRows) > 0,
    AVERAGEX(SeriesRows, fact_observation[value]),
    BLANK()
)

Satellite Cloud Contaminated Count =
CALCULATE(
    COUNTROWS(fact_observation),
    fact_observation[source_id] = "modis",
    fact_observation[spatial_support] = "grid_point",
    fact_observation[measure] = "ndvi",
    fact_observation[quality_flag] = "cloud_contaminated"
)

// No default SUM/AVERAGE(value): prices, rainfall, production, NDVI and estimates
// have incompatible grains. Keep value set to "Do not summarize" in the model.
// Add a domain-specific aggregate only after commodity, unit, definition, season,
// source, non-overlapping area/time and subtotal rules have been validated.
