{
  "name": "tadih-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-data.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "local": "node scripts/start-local.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.2.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "0.0.1",
    "vinext": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.v.4",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.38",
    "cf": "^1.0.0-beta.21",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "vite-css-modules": "^1.16.0"
  }
}
