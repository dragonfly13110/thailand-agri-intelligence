    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "data_kind": {
      "const": "forecast"
    },
    "backtest_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/@]+(?:/|$)"
    },
    "license_status": {
      "enum": [
        "approved_public",
        "restricted",
        "pending"
      ]
    }
