    "source_id",
    "point_estimate",
    "p10",
    "p50",
    "p90",
    "unit",
    "data_kind",
    "backtest_score",
    "source_url",
    "license_status"
  ],
  "additionalProperties": false,
  "description": "Provider/model forecasts stay separate from observations. Local model publication additionally requires scorecard gate and leakage-safe release cutoff."
}
