    "expected_count",
    "actual_count",
    "gap_count",
    "latest_observation_date"
  ],
  "additionalProperties": false,
  "description": "Source x province x period coverage. UNVERIFIED does not mean not published. Actual count may be zero imported rows; expected/gap counts remain null until known. Never turn a missing measurement into zero."
