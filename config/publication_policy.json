        "OGL-Thailand",
        "NASA Open Data Policy / US Government Work",
        "Public Domain"
      ],
      "assumptions": [
        "A label without a version or URL is treated as the current attribution variant (CC BY 4.0 or ODC-By).",
        "If the provider later names a share-alike variant, derived tables are re-reviewed before further publication."
      ]
    },
    {
      "id": "open_noncommercial",
      "decision": "approved_public",
      "commercial_use_confirmed": false,
      "derivation_allowed": true,
      "license_ids": [
        "Creative Commons Attributions Non-Commercial",
        "Creative Commons Attribution Non-Commercial"
      ],
      "assumptions": [
        "Project use is a non-commercial public-service dashboard; commercial reuse is not approved."
      ]
    },
    {
      "id": "open_no_derivatives",
      "decision": "approved_public",
      "commercial_use_confirmed": true,
      "derivation_allowed": false,
      "license_ids": ["Creative Commons Attribution No-Derivs"],
      "assumptions": [
        "Only verbatim source values may be displayed; computed indices or rollups are not approved."
      ]
    },
    {
      "id": "open_noncommercial_no_derivatives",
      "decision": "approved_public",
      "commercial_use_confirmed": false,
      "derivation_allowed": false,
      "license_ids": ["Creative Commons Attribution Non-Commercial No-Derivs"],
      "assumptions": [
        "Project use is non-commercial and only verbatim source values may be displayed."
      ]
