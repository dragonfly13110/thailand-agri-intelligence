# ==============================================================================
# ศูนย์รวมข้อมูลเกษตรระดับประเทศ (Thailand Agricultural Intelligence Hub)
# Environment Configuration Template
# คัดลอกไฟล์นี้เป็น .env แล้วกรอก API Key / Token ที่ได้รับ
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DGA / Open Government Data of Thailand (opend.data.go.th / data.go.th)
# สมัครและคัดลอกจาก: https://opend.data.go.th/register_api/profile.php
# บริการ: Opend (opend-search)
# ------------------------------------------------------------------------------
OPEND_API_KEY=
DATA_GO_TH_API_KEY=

# ------------------------------------------------------------------------------
# 2. DOAE CKAN API Key (ckan.doae.go.th)
# สำหรับเชื่อมต่อชุดข้อมูลที่มีการจำกัดสิทธิ์ภายใน กรมส่งเสริมการเกษตร
# ------------------------------------------------------------------------------
DOAE_CKAN_API_KEY=

# ------------------------------------------------------------------------------
# 3. Geo-Spatial & Satellite Intelligence (GISTDA Sphere)
# สมัครและขอรับ Map / Service Key จาก https://sphere.gistda.or.th
# ------------------------------------------------------------------------------
GISTDA_API_KEY=

# ------------------------------------------------------------------------------
# 4. Meteorological Weather Intelligence (Meteostat / RapidAPI)
# สมัครและรับ RapidAPI Key จาก https://rapidapi.com/meteostat/api/meteostat/
# ------------------------------------------------------------------------------
METEOSTAT_API_KEY=

# ------------------------------------------------------------------------------
# 5. Department of Water Resources (DWR / กรมทรัพยากรน้ำ)
# เชื่อมต่อระบบแลกเปลี่ยนข้อมูลน้ำ แหล่งน้ำขนาดเล็ก-กลาง และระบบเตือนภัย
# ------------------------------------------------------------------------------
DWR_API_BASE_URL=https://api.dwr.go.th
DWR_API_KEY=

# ------------------------------------------------------------------------------
# 6. TADIH Internal & Data Sharing Settings
# ------------------------------------------------------------------------------
TADIH_ENV=development
TADIH_DATA_DIR=data/local
TADIH_PARTNER_API_KEY=
